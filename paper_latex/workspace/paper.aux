\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Mean answer coefficient of variation (CV), fraction of samples matching the gold answer, and logprob-entropy proxies (nats), pooled across 16 seed problems and 3 models, per content-type x length-tier condition. These are descriptive means; Table\nobreakspace  {}\ref {tab:cvgap} reports the corresponding paired, seed-clustered bootstrap confidence intervals on the elaboration-minus-filler gap.}}{8}{table.1}\protected@file@percent }
\newlabel{tab:main}{{1}{8}{Mean answer coefficient of variation (CV), fraction of samples matching the gold answer, and logprob-entropy proxies (nats), pooled across 16 seed problems and 3 models, per content-type x length-tier condition. These are descriptive means; Table~\ref {tab:cvgap} reports the corresponding paired, seed-clustered bootstrap confidence intervals on the elaboration-minus-filler gap}{table.1}{}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Paired, seed-clustered bootstrap 95\% CIs and Wilcoxon signed-rank p-values for the elaboration-minus-filler CV gap, computed against the 16 seed problems' paired deltas. Only the medium tier and the pooled-across-tiers estimate exclude zero individually; short and long each touch or cross zero at the tier-specific sample size of 16 seeds.}}{8}{table.2}\protected@file@percent }
\newlabel{tab:cvgap}{{2}{8}{Paired, seed-clustered bootstrap 95\% CIs and Wilcoxon signed-rank p-values for the elaboration-minus-filler CV gap, computed against the 16 seed problems' paired deltas. Only the medium tier and the pooled-across-tiers estimate exclude zero individually; short and long each touch or cross zero at the tier-specific sample size of 16 seeds}{table.2}{}}
